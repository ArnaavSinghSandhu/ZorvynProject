{
  "info": {
    "_postman_id": "finance-ledger-api-v1",
    "name": "Finance Ledger API",
    "description": "Complete API collection for Finance Data Processing and Access Control Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Create a new user account. Role defaults to 'viewer' if not specified."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.environment.set(\"auth_token\", jsonData.data.token);",
                  "    pm.environment.set(\"user_role\", jsonData.data.user.role);",
                  "    console.log('Token saved to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate and receive JWT token. Token is automatically saved to environment variable 'auth_token'."
          },
          "response": []
        }
      ]
    },
    {
      "name": "📊 Dashboard",
      "item": [
        {
          "name": "Get Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/summary",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "summary"]
            },
            "description": "Get total income, total expenses, and net balance.\n\nAccessible by: viewer, analyst, admin"
          },
          "response": []
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/categories",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "categories"]
            },
            "description": "Get category breakdown with totals and counts.\n\nAccessible by: viewer, analyst, admin"
          },
          "response": []
        },
        {
          "name": "Get Trends",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/trends",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "trends"]
            },
            "description": "Get monthly aggregated data (income, expenses, net).\n\nAccessible by: viewer, analyst, admin"
          },
          "response": []
        },
        {
          "name": "Get Recent Activity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/recent-activity?limit=10",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "recent-activity"],
              "query": [
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of records to return (default: 10, max: 50)"
                }
              ]
            },
            "description": "Get recent financial records.\n\nQuery params:\n- limit: items per page (default: 10, max: 50)\n\nAccessible by: viewer, analyst, admin"
          },
          "response": []
        }
      ],
      "description": "Dashboard summary endpoints for all authenticated users"
    },
    {
      "name": "📝 Financial Records",
      "item": [
        {
          "name": "List Records (with filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/records?type=income&category=Salary&startDate=2024-01-01&endDate=2024-12-31&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["records"],
              "query": [
                {
                  "key": "type",
                  "value": "income",
                  "description": "Filter by type: income or expense"
                },
                {
                  "key": "category",
                  "value": "Salary",
                  "description": "Filter by category name"
                },
                {
                  "key": "startDate",
                  "value": "2024-01-01",
                  "description": "Start date (YYYY-MM-DD)"
                },
                {
                  "key": "endDate",
                  "value": "2024-12-31",
                  "description": "End date (YYYY-MM-DD)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 50)"
                }
              ]
            },
            "description": "List all records with optional filtering and pagination.\n\nQuery params:\n- type: income or expense\n- category: any string\n- startDate/endDate: YYYY-MM-DD format\n- page: page number\n- limit: items per page\n\nAccessible by: analyst, admin\n❌ Viewer gets 403 Forbidden"
          },
          "response": []
        },
        {
          "name": "Create Record",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.id) {",
                  "    pm.environment.set(\"record_id\", jsonData.data.id);",
                  "    console.log('Record ID saved: ' + jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000.00,\n  \"type\": \"income\",\n  \"category\": \"Salary\",\n  \"date\": \"2024-04-01\",\n  \"notes\": \"Monthly salary payment\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/records",
              "host": ["{{base_url}}"],
              "path": ["records"]
            },
            "description": "Create a new financial record.\n\nBody fields:\n- amount: positive number (required)\n- type: 'income' or 'expense' lowercase (required)\n- category: string (required)\n- date: YYYY-MM-DD (required)\n- notes: string, max 255 chars (optional)\n\nAccessible by: admin only\n❌ Viewer, Analyst get 403 Forbidden"
          },
          "response": []
        },
        {
          "name": "Update Record",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5500.00,\n  \"notes\": \"Updated amount with bonus\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/records/{{record_id}}",
              "host": ["{{base_url}}"],
              "path": ["records", "{{record_id}}"]
            },
            "description": "Update an existing record. All fields optional - only provided fields are updated.\n\nAccessible by: admin only\n❌ Viewer, Analyst get 403 Forbidden"
          },
          "response": []
        },
        {
          "name": "Delete Record (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/records/{{record_id}}",
              "host": ["{{base_url}}"],
              "path": ["records", "{{record_id}}"]
            },
            "description": "Soft delete a record (sets deleted_at timestamp).\n\nAccessible by: admin only\n❌ Viewer, Analyst get 403 Forbidden"
          },
          "response": []
        }
      ],
      "description": "CRUD operations for financial records"
    },
    {
      "name": "👤 User Management",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            },
            "description": "Get all users.\n\nAccessible by: admin only\n❌ Viewer, Analyst get 403 Forbidden"
          },
          "response": []
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/1",
              "host": ["{{base_url}}"],
              "path": ["users", "1"]
            },
            "description": "Get specific user details.\n\nAccessible by: admin only\n❌ Viewer, Analyst get 403 Forbidden"
          },
          "response": []
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"analyst\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/2/role",
              "host": ["{{base_url}}"],
              "path": ["users", "2", "role"]
            },
            "description": "Change user role.\n\nBody:\n- role: 'viewer', 'analyst', or 'admin'\n\nAccessible by: admin only"
          },
          "response": []
        },
        {
          "name": "Toggle User Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/2/status",
              "host": ["{{base_url}}"],
              "path": ["users", "2", "status"]
            },
            "description": "Toggle user between active/inactive status.\n\nAccessible by: admin only"
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/2",
              "host": ["{{base_url}}"],
              "path": ["users", "2"]
            },
            "description": "Permanently delete a user.\n\nNote: Cannot delete your own account (returns 400).\n\nAccessible by: admin only"
          },
          "response": []
        }
      ],
      "description": "User management endpoints for admin only"
    },
    {
      "name": "🧪 Test Flows",
      "item": [
        {
          "name": "Step 1: Register Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Admin\",\n  \"email\": \"admin@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Step 2: Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.environment.set(\"admin_token\", jsonData.data.token);",
                  "    pm.environment.set(\"auth_token\", jsonData.data.token);",
                  "    console.log('Admin token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Step 3: Create Records (x3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000,\n  \"type\": \"income\",\n  \"category\": \"Salary\",\n  \"date\": \"2024-04-01\",\n  \"notes\": \"April salary\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/records",
              "host": ["{{base_url}}"],
              "path": ["records"]
            }
          },
          "response": []
        },
        {
          "name": "Step 4: Check Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/summary",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "summary"]
            }
          },
          "response": []
        },
        {
          "name": "Step 5: Register Viewer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Viewer\",\n  \"email\": \"viewer@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"viewer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Step 6: Login Viewer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.environment.set(\"viewer_token\", jsonData.data.token);",
                  "    console.log('Viewer token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"viewer@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Step 7: Viewer Tries Records (Should Fail 403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{viewer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/records",
              "host": ["{{base_url}}"],
              "path": ["records"]
            }
          },
          "response": []
        }
      ],
      "description": "Complete test flow to verify all functionality"
    }
  ],
